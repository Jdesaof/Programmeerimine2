@page "/olud"
@inject KooliProjekt.BlazorWasm.Api.IApiClient ApiClient
@implements IDisposable

<PageTitle>Õlud</PageTitle>
<h1>Õlud</h1>
<p><a class="btn btn-primary" href="/create">Lisa uus</a></p>
@if (loading)
{
    <p role="status">Laadin…</p>
}
else if (error != null)
{
    <div class="alert alert-danger" role="alert">@error</div>
    <button class="btn btn-primary" @onclick="() => Load(page)">Proovi uuesti</button>
}
else if (data != null)
{
    @if (data.Results.Count == 0) { <p>Õllesid ei leitud.</p> }
    else
    {
        <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>Id</th><th>Nimi</th><th>Tüüp</th><th>Alkohol (%)</th><th>Kirjeldus</th><th>Tegevused</th></tr></thead>
            <tbody>
            @foreach (var item in data.Results)
            {
                <tr @key="item.Id"><td>@item.Id</td><td>@item.Nimi</td><td>@item.Tuup</td><td>@item.Alkoholiprotsent</td><td>@item.Kirjeldus</td><td><a class="btn btn-success" href="/edit/@item.Id">Muuda</a></td></tr>
            }
            </tbody>
        </table>
        </div>
    }
    <p>Kokku: @data.RowCount</p>
    <button class="btn btn-outline-primary" disabled="@(page <= 1)" @onclick="() => Load(page - 1)">Eelmine</button>
    <span class="mx-3">Leht @(page) / @Math.Max(1, data.PageCount)</span>
    <button class="btn btn-outline-primary" disabled="@(page >= data.PageCount)" @onclick="() => Load(page + 1)">Järgmine</button>
}

@code {
    private PagedResult<Olu> data;
    private string error;
    private bool loading;
    private int page = 1;
    private readonly CancellationTokenSource cancellation = new();

    protected override Task OnInitializedAsync() => Load(1);

    private async Task Load(int requestedPage)
    {
        if (loading) return;
        loading = true;
        error = null;
        page = requestedPage;
        try
        {
            var result = await ApiClient.List(page, 20, cancellation.Token);
            if (result.HasErrors)
                error = string.Join(" ", (result.Errors ?? new List<string>()).Concat(result.PropertyErrors?.Values ?? Enumerable.Empty<string>()));
            else data = result.Value;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception) { error = "Andmete laadimine ebaõnnestus. Proovi uuesti."; }
        finally { loading = false; }
    }

    public void Dispose() { cancellation.Cancel(); cancellation.Dispose(); }
}